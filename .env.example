# Copy this file to .env.local and fill in real values. Never commit .env.local.

# ── Adzuna (global jobs) ─────────────────────────────────────────────
# Free keys: https://developer.adzuna.com/signup  → Dashboard → "API access details"
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
# Comma-separated country codes to search (default: gb,us). Each country costs
# 20 requests per daily refresh; Adzuna's free limit is 250 requests/day.
ADZUNA_COUNTRIES=gb,us

# ── Vercel Cron ──────────────────────────────────────────────────────
# Random string (16+ characters). Vercel sends it as "Authorization: Bearer <secret>".
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=replace-with-a-long-random-string

# ── Job snapshot storage (Upstash Redis) ─────────────────────────────
# Required in production (Vercel's file system is read-only). Locally, leave
# these empty and the snapshot is saved to .data/live-jobs.json instead.
# Vercel Marketplace → Upstash Redis injects KV_REST_API_URL / KV_REST_API_TOKEN
# automatically; UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Remotive (remote jobs) needs no key.
